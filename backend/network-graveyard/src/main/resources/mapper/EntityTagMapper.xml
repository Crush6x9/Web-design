<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neu.mapper.EntityTagMapper">
    <resultMap id="EntityTagResultMap" type="com.neu.domain.EntityTag">
        <id column="entity_id" property="entityId"/>
        <id column="tag_id" property="tagId"/>
    </resultMap>

    <select id="findByEntityId" resultMap="EntityTagResultMap">
        SELECT * FROM entity_tags WHERE entity_id = #{entityId}
    </select>

    <insert id="insert" parameterType="com.neu.domain.EntityTag">
        INSERT INTO entity_tags (entity_id, tag_id)
        VALUES (#{entityId}, #{tagId})
    </insert>
</mapper>