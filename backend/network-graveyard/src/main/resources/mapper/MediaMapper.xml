<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neu.mapper.MediaMapper">
    <resultMap id="MediaResultMap" type="com.neu.domain.Media">
        <id column="id" property="id"/>
        <result column="entity_id" property="entityId"/>
        <result column="name" property="name"/>
        <result column="url" property="url"/>
        <result column="type" property="type"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="findByEntityId" resultMap="MediaResultMap">
        SELECT * FROM media WHERE entity_id = #{entityId}
    </select>

    <insert id="insert" parameterType="com.neu.domain.Media">
        INSERT INTO media (entity_id, name, url, type, create_by, create_time, update_by, update_time)
        VALUES (#{entityId}, #{name}, #{url}, #{type}, #{createBy}, #{createTime}, #{updateBy}, #{updateTime})
    </insert>
</mapper>